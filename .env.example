# Docker Compose 설정. 모두 과제 시연용 개발 자격 증명이다.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin-dev-password
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_PORT=8080
# host에서 Node를 실행할 때는 각 service의 .env를 사용한다.
# 아래 두 내부 주소는 full profile의 컨테이너 간 통신용이다.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
ISSUER_KEY_URL=http://service-a:3001/api/issuer-key
SERVICE_A_PORT=3001
SERVICE_B_PORT=3002
SERVICE_A_BASE_URL=http://localhost:3001
SERVICE_B_BASE_URL=http://localhost:3002
SERVICE_A_CLIENT_SECRET=service-a-dev-secret
SERVICE_B_CLIENT_SECRET=service-b-dev-secret
SERVICE_A_SESSION_SECRET=local-only-service-a-replace-this-session-secret
SERVICE_B_SESSION_SECRET=local-only-service-b-replace-this-session-secret
SERVICE_A_BACKCHANNEL_LOGOUT_URL=http://host.docker.internal:3001/backchannel-logout
SERVICE_B_BACKCHANNEL_LOGOUT_URL=http://host.docker.internal:3002/backchannel-logout
# full profile에서 VM 내부 주소로 직접 보내려면 위 두 값을 다음처럼 설정한다.
# SERVICE_A_BACKCHANNEL_LOGOUT_URL=http://service-a:3001/backchannel-logout
# SERVICE_B_BACKCHANNEL_LOGOUT_URL=http://service-b:3002/backchannel-logout
# Test credentials only (realm JSON에도 동일하게 기록됨):
# alice password: alice-dev-password
# bob password: bob-dev-password
