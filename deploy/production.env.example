# 운영 설정 예시. 실제 파일은 deploy/gen-env.sh 로 만든 deploy/production.env 이며 git 에 올리지 않는다.

# 사이트 주소 (Caddy). 도메인만 쓰면 자동 HTTPS, http:// 로 시작하면 HTTP 전용(로컬 리허설)
IDP_SITE=idp.ericshim.me
SIGN_SITE=sign.ericshim.me
VERIFY_SITE=verify.ericshim.me
ACME_EMAIL=you@example.com

# 브라우저가 보는 주소 (위 사이트 주소와 맞춘다)
KEYCLOAK_PUBLIC_URL=https://idp.ericshim.me
SERVICE_A_BASE_URL=https://sign.ericshim.me
SERVICE_B_BASE_URL=https://verify.ericshim.me

# 비밀값 — gen-env.sh 가 무작위로 채운다
POSTGRES_PASSWORD=
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=
SERVICE_A_CLIENT_SECRET=
SERVICE_B_CLIENT_SECRET=
SERVICE_A_SESSION_SECRET=
SERVICE_B_SESSION_SECRET=

# 시연 계정 비밀번호 (발표 자료에 적어 교수님께 공유할 값)
DEMO_ALICE_PASSWORD=
DEMO_BOB_PASSWORD=

# 메모리가 1GB 인 서버라면 Keycloak 힙을 줄인다
KC_HEAP_OPTS=-XX:MaxRAMPercentage=50

# 회원가입 reCAPTCHA v2 체크박스 (https://www.google.com/recaptcha/admin/create 에서 발급)
# 키를 넣은 뒤 deploy/enable-recaptcha.sh 를 실행한다
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=
