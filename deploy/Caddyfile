# 리버스 프록시. 사이트 주소는 production.env 에서 받는다.
# 도메인(예: idp.ericshim.me)이면 Caddy가 Let's Encrypt 인증서를 자동으로 받고,
# "http://idp.localhost" 처럼 http:// 로 시작하면 로컬 리허설용으로 HTTP만 연다.
{
	email {$ACME_EMAIL:admin@example.invalid}
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

{$IDP_SITE} {
	import security_headers
	# 관리 콘솔과 master realm 은 인터넷에 열지 않는다. 관리는 SSH 터널로 127.0.0.1:8080 에 붙어서 한다.
	@admin path /admin /admin/* /realms/master /realms/master/*
	respond @admin "Not Found" 404
	reverse_proxy keycloak:8080
}

{$SIGN_SITE} {
	import security_headers
	reverse_proxy service-a:3001
}

{$VERIFY_SITE} {
	import security_headers
	reverse_proxy service-b:3002
}
